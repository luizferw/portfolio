---
import en from '../i18n/en.json';
import pt from '../i18n/pt.json';
---

<section id="contact" class="relative overflow-hidden bg-[var(--color-bg-2)] py-32 sm:py-44">
  <div class="pointer-events-none absolute inset-x-0 top-1/2 -z-10 h-[60vmin] -translate-y-1/2 opacity-60 blur-3xl"
    style="background: radial-gradient(50% 50% at 50% 50%, oklch(0.8 0.155 70 / 0.22), transparent 70%);">
  </div>

  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p class="kicker mb-6" data-reveal data-i18n-en={en.contact.kicker} data-i18n-pt={pt.contact.kicker}>{en.contact.kicker}</p>

    <h2 class="font-[var(--font-display)] text-[clamp(2.4rem,7vw,5.5rem)] font-extrabold leading-[0.98] tracking-[-0.02em]" data-reveal data-i18n-en={en.contact.title} data-i18n-pt={pt.contact.title}>
      {en.contact.title}
    </h2>

    <p class="mx-auto mt-7 max-w-xl text-lg text-muted" data-reveal data-reveal-delay="0.1" data-i18n-en={en.contact.body} data-i18n-pt={pt.contact.body}>
      {en.contact.body}
    </p>

    <div class="mt-11 flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delay="0.2">
      <a
        href="mailto:contato@luizwitt.dev"
        class="magnetic inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-medium text-bg transition-shadow duration-300 hover:shadow-[0_0_44px_-8px_var(--color-accent)]"
        data-i18n-en={en.contact.email}
        data-i18n-pt={pt.contact.email}>{en.contact.email}</a>
      <a
        href="https://github.com/luizferw"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--line-strong)] px-7 py-3.5 transition-colors hover:border-accent hover:text-accent">GitHub</a>
      <a
        href="https://www.linkedin.com/in/luizfernandowitt"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--line-strong)] px-7 py-3.5 transition-colors hover:border-accent hover:text-accent">LinkedIn</a>
    </div>

    <p class="mt-10 inline-flex items-center gap-2 rounded-full border border-[var(--line)] px-4 py-2 font-[var(--font-mono)] text-xs text-muted" data-reveal data-reveal-delay="0.3">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
      <span data-i18n-en={en.contact.cert} data-i18n-pt={pt.contact.cert}>{en.contact.cert}</span>
    </p>
  </div>
</section>
