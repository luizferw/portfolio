---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'pt-BR';
}
const { title, description, lang = 'pt-BR' } = Astro.props;
const site = 'https://luizwitt.dev'; // PLACEHOLDER_CONFIG: replace with the canonical production URL if different.
const ogImage = `${site}/og/og.png`;
---

<!doctype html>
<html lang={lang} class="no-js" data-locale={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101820" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luiz Fernando Witt" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={site} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={site} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <script is:inline>
      // flip no-js -> js as early as possible so reveals stay hidden pre-anim
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="skip"
      >Pular para o conteúdo</a
    >
    <slot />
  </body>
</html>
