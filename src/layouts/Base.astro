---
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'pt-BR';
}
const { title, description, lang = 'pt-BR' } = Astro.props;
const site = 'https://luizwitt.dev'; // PLACEHOLDER_CONFIG: replace with the canonical production URL if different.
const ogImage = `${site}/og/og.png`;
---

<!doctype html>
<html lang={lang} class="no-js" data-locale={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101820" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luiz Fernando Witt" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={site} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={site} />
    <script is:inline>
      (() => {
        const websiteId = '42da2378-7c50-46a4-837f-7ad8c2b3cc4a';
        const loadUmami = () => {
          if (document.querySelector('script[data-umami-tracker]')) return;
          const script = document.createElement('script');
          script.src = 'https://cloud.umami.is/script.js';
          script.async = true;
          script.dataset.websiteId = websiteId;
          script.dataset.umamiTracker = '';
          document.head.appendChild(script);
        };
        const scheduleUmami = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadUmami, { timeout: 2000 });
          } else {
            window.setTimeout(loadUmami, 2000);
          }
        };
        window.addEventListener('load', scheduleUmami, { once: true });
      })();
    </script>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <script is:inline>
      // flip no-js -> js as early as possible so reveals stay hidden pre-anim
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="skip"
      >Pular para o conteúdo</a
    >
    <slot />
  </body>
</html>
