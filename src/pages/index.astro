---
import Base from '../layouts/Base.astro';

const title = 'Desenvolvimento sob demanda para empresas e agências | Luiz Witt';
const description = 'Correção de bugs, desenvolvimento de funcionalidades e integrações em React, Node.js, Vue, PHP e WordPress. Projetos pontuais com escopo, prazo e valor definidos.';
const CONTACT = { email: 'contato@luizwitt.dev', linkedin: 'https://www.linkedin.com/in/luizfernandowitt', github: 'https://github.com/luizferw' };
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const contactReady = Boolean(contactEndpoint && turnstileSiteKey);
const hasEmail = !CONTACT.email.includes('SEU_');
const hasLinkedIn = !CONTACT.linkedin.includes('SEU_');
const hasGitHub = !CONTACT.github.includes('SEU_');
---
<Base title={title} description={description}>
  <!-- THESIS: Transformo demandas técnicas incertas em entregas finitas e rastreáveis. OWN-WORLD: uma ordem de serviço visual, objetiva e preparada para revisão. STORY: da demanda ao PR, cada etapa fica explícita. FIRST VIEWPORT: oferta, R$ 750, critérios e CTA aparecem junto do preview. FORM: descreva o problema para avaliação por e-mail. -->
  <header class="site-header">
    <nav class="nav wrap" aria-label="Navegação principal">
      <a class="brand" href="#main">LUIZ WITT<i aria-hidden="true"></i></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
      <div class="nav-links" id="nav-links">
        <a href="#resolve">Serviços</a><a href="#processo">Como funciona</a><a href="#tecnologias">Tecnologias</a><a href="#sobre">Sobre</a><a href="#faq">Perguntas frequentes</a><a class="nav-cta" href="#demanda">Enviar uma demanda</a>
      </div>
    </nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow signal">Desenvolvimento sob demanda</p>
          <h1 id="hero-title">Tire demandas técnicas do backlog <span class="signal">sem contratar outro desenvolvedor</span></h1>
          <p class="hero-lede">Ajudo agências, startups e equipes de software a corrigir bugs, implementar funcionalidades e integrar sistemas em produtos existentes.</p>
          <div class="hero-actions"><a class="button button-primary" href="#demanda">Enviar uma demanda →</a><a class="button button-ghost" href="#processo">Ver como funciona</a></div>
          <p class="hero-offer">Projetos pontuais a partir de R$ 750. Escopo, prazo e valor definidos antes do início.</p>
        </div>
        <div class="evidence-panel">
          <div class="order-top"><span class="eyebrow">Proposta antes do início</span><span class="status">CLARA</span></div>
          <dl><div class="order-row"><dt>Escopo</dt><dd>O que será entregue e o que fica fora</dd></div><div class="order-row"><dt>Prazo</dt><dd>Data ou janela de execução combinada</dd></div><div class="order-row"><dt>Valor fixo</dt><dd>Projetos pontuais a partir de R$ 750.</dd></div><div class="order-row"><dt>Aceite</dt><dd>Critérios objetivos para revisar a entrega</dd></div></dl>
        </div>
      </div>
    </section>

    <section class="section section-dark" id="resolve" aria-labelledby="resolve-title"><div class="wrap"><div class="section-head"><span class="section-index">02 / ESCOPO</span><div><h2 id="resolve-title">O que posso resolver</h2><p class="intro">Trabalho pontual para problemas reais, em React, Node.js, Vue.js, PHP e WordPress.</p></div></div><div class="dark-grid"><article class="service"><span class="tag">01 — Destravar</span><h3>Correção de bugs</h3><p>Erros em React/Vue, APIs Node, formulários, responsividade, autenticação, integrações, build/deploy, PHP e WordPress.</p></article><article class="service"><span class="tag">02 — Evoluir</span><h3>Desenvolvimento de funcionalidades</h3><p>Telas e componentes, fluxos CRUD, dashboards e admin, filtros, tabelas e relatórios, formulários, layouts existentes e ferramentas internas.</p></article><article class="service"><span class="tag">03 — Conectar</span><h3>APIs e integrações</h3><p>APIs externas, webhooks, sincronização de dados, arquivos, frontend/backend, automações Node, pagamentos, CRM, ERP e terceiros.</p></article><article class="service"><span class="tag">04 — Manter</span><h3>WordPress e PHP</h3><p>Plugins e temas, páginas e formulários, atualizações, WooCommerce, integrações externas, performance e layout responsivo.</p></article></div></div></section>

    <section class="section"><div class="wrap"><div class="offer"><div><p class="eyebrow">Entrada recomendada</p><h2>Comece com uma tarefa pontual.</h2><p>Projetos pontuais a partir de R$ 750. Não há mensalidade obrigatória: o valor final depende da complexidade, estado do projeto, acessos e prazo.</p><a class="button button-ghost" href="#demanda">Descrever minha demanda →</a></div><div><p class="eyebrow">A proposta inclui</p><ul class="checklist"><li>Objetivo e escopo</li><li>Prazo e valor fixo</li><li>Critérios de aceite</li><li>Exclusões e limites</li></ul></div></div></div></section>

    <section class="section section-dark results" aria-labelledby="results-title"><div class="wrap"><div class="section-head"><span class="section-index">03 / EVIDÊNCIA</span><div><h2 id="results-title">Resultados em projetos reais</h2><p class="intro">Experiência aplicada em produtos digitais, com contexto, contribuição e resultado descritos sem atalhos.</p></div></div><div class="results-list"><article class="result"><div class="result-marker"><span class="eyebrow">01</span><span class="result-line" aria-hidden="true"></span></div><div class="result-body"><p class="eyebrow result-context">SaaS B2B / processamento de documentos</p><h3>Processamento de documentos</h3><dl class="result-facts"><div><dt>Problema</dt><dd>Um processo crítico de documentos levava aproximadamente 9 segundos.</dd></div><div><dt>Contribuição</dt><dd>Reconstrução e automação do pipeline de processamento.</dd></div><div class="result-outcome"><dt>Resultado</dt><dd>Tempo reduzido para menos de 1 segundo.</dd></div><div><dt>Tecnologias</dt><dd>FastAPI, AWS SQS, S3, Lambda e MySQL.</dd></div></dl></div></article><article class="result"><div class="result-marker"><span class="eyebrow">02</span><span class="result-line" aria-hidden="true"></span></div><div class="result-body"><p class="eyebrow result-context">Portal de parceiros / operação financeira</p><h3>Operação financeira</h3><dl class="result-facts"><div><dt>Problema</dt><dd>A operação de pagamentos via PIX era manual.</dd></div><div><dt>Contribuição</dt><dd>Construção do portal e da automação da operação.</dd></div><div class="result-outcome"><dt>Resultado</dt><dd>Mais de R$ 500 mil em pagamentos PIX mensais automatizados e cerca de 20 horas mensais poupadas da equipe financeira.</dd></div><div><dt>Tecnologias</dt><dd>Next.js, Node.js, TypeScript e AWS.</dd></div></dl></div></article><article class="result"><div class="result-marker"><span class="eyebrow">03</span><span class="result-line" aria-hidden="true"></span></div><div class="result-body"><p class="eyebrow result-context">SaaS B2B / produção de materiais</p><h3>Produção de materiais</h3><dl class="result-facts"><div><dt>Problema</dt><dd>A criação de materiais personalizados levava horas.</dd></div><div><dt>Contribuição</dt><dd>Construção de um editor de templates SVG.</dd></div><div class="result-outcome"><dt>Resultado</dt><dd>Criação reduzida de horas para minutos.</dd></div><div><dt>Tecnologias</dt><dd>Vue.js, Django e PostgreSQL.</dd></div></dl></div></article></div></div></section>

    <section class="section" id="para-quem" aria-labelledby="audience-title"><div class="wrap"><div class="section-head"><span class="section-index">04 / PARA QUEM</span><div><h2 id="audience-title">Apoio técnico para equipes que precisam entregar.</h2><p class="intro">Você traz o contexto do produto. Eu entro em uma demanda delimitada, sem interromper o ritmo da sua equipe.</p></div></div><div class="audience"><article><p class="eyebrow">01</p><h3>Agências digitais</h3><p>Execução técnica para completar entregas de clientes, destravar bugs e integrar serviços sem aumentar o time fixo.</p></article><article><p class="eyebrow">02</p><h3>Startups e empresas SaaS</h3><p>Capacidade especializada para tirar uma funcionalidade ou dívida técnica do caminho enquanto o time cuida do produto.</p></article><article><p class="eyebrow">03</p><h3>Empresas com sistemas próprios</h3><p>Manutenção e evolução de sistemas internos, com atenção ao código existente e ao impacto na operação.</p></article></div></div></section>

    <section class="section" id="processo" aria-labelledby="process-title"><div class="wrap"><div class="section-head"><span class="section-index">05 / RITO</span><div><h2 id="process-title">Um processo simples e previsível</h2><p class="intro">A execução começa somente depois que você entende o que será entregue e aprova a proposta.</p></div></div><div class="process"><article class="step"><strong>01</strong><h3>Envie a demanda</h3><p>Problema, resultado esperado, tecnologia, prazo e contexto.</p></article><article class="step"><strong>02</strong><h3>Avalio o contexto</h3><p>Entendo o produto, o código e o que precisa estar acessível.</p></article><article class="step"><strong>03</strong><h3>Apresento para sua aprovação</h3><p>Você recebe escopo, prazo, valor, aceite e exclusões.</p></article><article class="step"><strong>04</strong><h3>Implemento em ambiente controlado</h3><p>A alteração é implementada preferencialmente em branch própria e entregue por pull request.</p></article><article class="step"><strong>05</strong><h3>Você revisa</h3><p>Entrega rastreável e ajustes dentro do escopo combinado.</p></article></div></div></section>

    <section class="section section-dark" aria-labelledby="modes-title"><div class="wrap"><div class="section-head"><span class="section-index">06 / FORMATO</span><div><h2 id="modes-title">Escolha o tamanho do compromisso.</h2></div></div><div class="modes"><article class="mode"><p class="eyebrow">Projetos pontuais a partir de R$ 750.</p><h3>Tarefa pontual</h3><p>Para um bug, ajuste, integração ou funcionalidade com começo e fim claros.</p></article><article class="mode"><p class="eyebrow">Bloco concentrado</p><h3>Sprint curta</h3><p>Para um conjunto pequeno de entregas relacionadas, com objetivo e janela definidos.</p></article><article class="mode"><p class="eyebrow">Depois da primeira entrega</p><h3>Suporte mensal</h3><p>Para manutenção e evolução contínuas, alinhadas a uma demanda inicial já conhecida.</p></article></div></div></section>

    <section class="section" id="tecnologias" aria-labelledby="tech-title"><div class="wrap"><div class="section-head"><span class="section-index">07 / FERRAMENTAS</span><div><h2 id="tech-title">Tecnologias que entram no fluxo.</h2></div></div><div class="tech-layout"><p class="intro">Não é uma lista para impressionar: são as tecnologias com que consigo entrar no seu projeto e produzir uma entrega integrada.</p><div class="tech-list"><div class="tech-row"><strong>Frontend</strong><span>React, Next.js, Vue.js, TypeScript, JavaScript, HTML e CSS</span></div><div class="tech-row"><strong>Backend</strong><span>Node.js, TypeScript, APIs REST, webhooks e integrações</span></div><div class="tech-row"><strong>PHP e CMS</strong><span>PHP, WordPress e WooCommerce</span></div><div class="tech-row"><strong>Fluxo</strong><span>Git, branch, pull request, staging e deploy</span></div></div></div></div></section>

    <section class="section section-dark"><div class="wrap"><div class="section-head"><span class="section-index">08 / COMPROMISSOS</span><div><h2>O que você pode esperar</h2><p class="intro">Princípios de trabalho para manter a demanda clara, integrada e revisável.</p></div></div><div class="diffs"><div><strong>Escopo antes da execução</strong></div><div><strong>Comunicação objetiva</strong></div><div><strong>Código integrado ao projeto existente</strong></div><div><strong>Entrega rastreável</strong></div><div><strong>Sem contrato de longo prazo</strong></div></div></div></section>

    <section class="section" id="sobre" aria-labelledby="about-title"><div class="wrap about-layout"><div><p class="eyebrow">09 / QUEM EXECUTA</p><h2 id="about-title">Luiz Witt, desenvolvimento que cabe no seu contexto.</h2></div><div><p>Trabalho com desenvolvimento web, APIs, integrações e manutenção. React e Node.js são minhas principais ferramentas; também atuo com Vue, PHP e WordPress.</p><p>Já participei de projetos brasileiros e internacionais, entrando em produtos existentes para resolver uma demanda específica com clareza sobre o que será entregue.</p><div class="inline-links">{hasLinkedIn ? <a href={CONTACT.linkedin} rel="noreferrer">LinkedIn ↗</a> : <span>LinkedIn indisponível</span>}{hasGitHub ? <a href={CONTACT.github} rel="noreferrer">GitHub ↗</a> : <span>GitHub indisponível</span>}{hasEmail ? <a href={`mailto:${CONTACT.email}`}>E-mail ↗</a> : <span>E-mail indisponível</span>}</div></div></div></section>

    <section class="section" aria-labelledby="evaluate-title"><div class="wrap"><div class="section-head"><span class="section-index">10 / ANTES DE ENVIAR</span><div><h2 id="evaluate-title">O que preciso para avaliar uma demanda</h2><p class="intro">Quanto melhor o contexto, mais precisa será a conversa inicial.</p></div></div><div class="audience"><article><h3>O problema</h3><p>O que acontece hoje, qual resultado você espera e como saberemos que está resolvido.</p></article><article><h3>O cenário</h3><p>Tecnologia utilizada, link do produto, prints, logs de erro e ambiente de staging quando possível.</p></article><article><h3>Os limites</h3><p>Prazo desejado, orçamento disponível e acessos necessários. <strong>Não envie senhas, tokens ou credenciais.</strong></p></article></div></div></section>

    <section class="section section-dark" id="faq" aria-labelledby="faq-title"><div class="wrap"><div class="section-head"><span class="section-index">11 / DÚVIDAS</span><div><h2 id="faq-title">Perguntas frequentes</h2></div></div><div class="faq"><details><summary>Você aceita projetos pontuais?</summary><p>Sim. Projetos pontuais são o formato principal: uma demanda delimitada, uma proposta e uma entrega revisável.</p></details><details><summary>É obrigatório contratar uma mensalidade?</summary><p>Não. A mensalidade não é obrigatória. Suporte mensal normalmente faz sentido depois de uma primeira entrega avulsa.</p></details><details><summary>Você cobra por hora ou faz diagnóstico pago?</summary><p>O trabalho é proposto por escopo e valor. Uma análise mais profunda pode ser combinada como diagnóstico pago quando a demanda exigir.</p></details><details><summary>R$ 750 é o valor final?</summary><p>Projetos pontuais a partir de R$ 750. O valor final depende da complexidade, estado do projeto, acessos e prazo.</p></details><details><summary>Você constrói produtos completos do zero?</summary><p>O foco é desenvolvimento sob demanda em produtos existentes. Uma construção maior pode ser avaliada caso a caso.</p></details><details><summary>Você atende demandas urgentes?</summary><p>O prazo é avaliado conforme o contexto e a fila de trabalho. Não prometo disponibilidade de emergência antes de conhecer a demanda.</p></details><details><summary>Existe suporte 24 horas?</summary><p>Não ofereço suporte 24 horas ou garantia de atendimento emergencial.</p></details><details><summary>Como funciona o pagamento?</summary><p>As condições de pagamento entram na proposta, junto com escopo, prazo e valor, antes do início.</p></details><details><summary>Você assina contrato ou NDA?</summary><p>Podemos alinhar contrato e NDA conforme a necessidade do projeto.</p></details></div></div></section>

    <section class="section contact" id="demanda" aria-labelledby="form-title"><div class="wrap contact-layout"><div class="contact-copy"><p class="eyebrow signal">12 / ENVIAR DEMANDA</p><h2 id="form-title">Tem uma demanda técnica parada?</h2><p>Preencha o contexto. Os detalhes serão enviados para avaliação por e-mail — sem senha, token ou credencial.</p></div><form class="contact-form" id="demand-form" novalidate aria-describedby="form-status turnstile-status"><div class="form-grid"><div class="field"><label for="name">Nome *</label><input id="name" name="name" required autocomplete="name" /></div><div class="field"><label for="company">Empresa ou projeto</label><input id="company" name="company" autocomplete="organization" /></div><div class="field"><label for="email">E-mail profissional *</label><input id="email" name="email" type="email" required autocomplete="email" /></div><div class="field"><label for="phone">Telefone (opcional)</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div><div class="field field-wide"><label for="site">Site ou produto</label><input id="site" name="site" type="url" placeholder="https://" /></div><div class="field"><label for="technology">Tecnologia utilizada</label><input id="technology" name="technology" placeholder="Ex.: React + Node.js, ou não sei informar" /></div><div class="field"><label for="deadline">Existe um prazo? *</label><select id="deadline" name="deadline" required><option value="">Selecione</option><option>Sim, tenho uma data definida</option><option>Tenho uma janela aproximada</option><option>Não tenho prazo definido</option></select></div><div class="field field-wide"><label for="demand">Qual é a demanda? *</label><textarea id="demand" name="demand" required placeholder="O que acontece hoje e qual resultado você espera?"></textarea></div><div class="field field-wide"><label for="budget">Orçamento *</label><select id="budget" name="budget" required><option value="">Selecione</option><option>Até R$ 1.500</option><option>De R$ 1.500 a R$ 3.000</option><option>De R$ 3.000 a R$ 5.000</option><option>Acima de R$ 5.000</option><option>Ainda não sei</option></select></div></div><div class="honeypot" aria-hidden="true"><label for="honeypot">Não preencher</label><input id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" /></div>{turnstileSiteKey ? <div class="turnstile-wrap"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact_form"></div></div> : null}<p class="turnstile-status" id="turnstile-status">{contactReady ? '' : `O envio está indisponível até que ${!contactEndpoint ? 'o endpoint de avaliação' : ''}${!contactEndpoint && !turnstileSiteKey ? ' e ' : ''}${!turnstileSiteKey ? 'a verificação de segurança' : ''} seja configurado.`}</p><div class="form-foot"><button class="button button-primary" type="submit" disabled={!contactReady}>Enviar para avaliação por e-mail</button><span class="form-note">Os detalhes preenchidos serão enviados ao endpoint de avaliação por e-mail, quando configurado. Você verá o resultado antes de sair da página.</span></div><p class="form-status" id="form-status" role="status" aria-live="polite"></p></form></div></section>
    <section class="final"><div class="wrap final-inner"><div><p class="eyebrow">Próximo passo</p><h2>Uma demanda descrita vale mais que um backlog parado.</h2></div><div class="hero-actions"><a class="button button-ghost" href="#demanda">Descrever minha demanda</a></div></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-grid"><div><a class="brand" href="#main">LUIZ WITT<i aria-hidden="true"></i></a><p>Desenvolvimento sob demanda em React, Node.js, Vue.js, PHP e WordPress.</p></div><div class="footer-links">{hasLinkedIn ? <a href={CONTACT.linkedin}>LinkedIn</a> : <span>LinkedIn indisponível</span>}{hasGitHub ? <a href={CONTACT.github}>GitHub</a> : <span>GitHub indisponível</span>}{hasEmail ? <a href={`mailto:${CONTACT.email}`}>E-mail</a> : <span>E-mail indisponível</span>}<a href="/politica-de-privacidade">Política de Privacidade</a><span>© 2026 Luiz Witt</span></div></div></footer>
</Base>

<script is:inline define:vars={{ endpoint: contactEndpoint }}>
  const navToggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#nav-links');
  const closeMenu = (returnFocus = false) => { navToggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); if (returnFocus) navToggle?.focus(); };
  navToggle?.addEventListener('click', () => { const open = navToggle.getAttribute('aria-expanded') === 'true'; navToggle.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('is-open', !open); });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && navToggle?.getAttribute('aria-expanded') === 'true') closeMenu(true); });
  const form = document.querySelector('#demand-form'); let status = document.querySelector('#form-status');
  if (!status && form) { status = document.createElement('p'); status.id = 'form-status'; status.className = 'form-status'; status.setAttribute('role', 'status'); status.setAttribute('aria-live', 'polite'); form.append(status); }
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.checkValidity()) { form.reportValidity(); status.textContent = 'Confira os campos obrigatórios antes de enviar.'; return; } if (!endpoint || !window.turnstile) { status.textContent = 'O envio está indisponível até que o endpoint e a verificação de segurança sejam configurados.'; return; } const widget = form.querySelector('.cf-turnstile'); const turnstileToken = window.turnstile.getResponse(widget); if (!turnstileToken) { status.textContent = 'Confirme a verificação de segurança antes de enviar.'; return; } const values = new FormData(form); const payload = { name: values.get('name'), email: values.get('email'), demand: values.get('demand'), deadline: values.get('deadline'), budget: values.get('budget'), turnstileToken }; ['company', 'phone', 'site', 'technology', 'honeypot'].forEach((key) => { const value = values.get(key); if (typeof value === 'string' && value.trim()) payload[key] = value.trim(); }); const submit = form.querySelector('button[type="submit"]'); submit.disabled = true; status.textContent = 'Enviando sua solicitação para avaliação…'; try { const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); const body = await response.json().catch(() => ({})); if (!response.ok) { throw new Error(typeof body.message === 'string' ? body.message : 'Não foi possível enviar sua solicitação.'); } form.reset(); window.turnstile.reset(widget); status.textContent = 'Solicitação enviada para avaliação por e-mail.'; } catch (error) { status.textContent = error instanceof Error ? error.message : 'Não foi possível enviar sua solicitação.'; } finally { submit.disabled = false; } });
</script>
