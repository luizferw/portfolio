---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Luiz Fernando Witt" description="Page not found.">
  <main class="grid min-h-[100svh] place-items-center px-6 text-center">
    <div>
      <p class="font-[var(--font-display)] text-[clamp(5rem,22vw,16rem)] font-extrabold leading-none text-gradient">404</p>
      <p class="mt-4 font-[var(--font-mono)] text-sm uppercase tracking-[0.3em] text-muted">Lost in production</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full border border-[var(--line-strong)] px-6 py-3 text-ink transition-colors hover:border-accent hover:text-accent">
        ← Back home
      </a>
    </div>
  </main>
</Base>
